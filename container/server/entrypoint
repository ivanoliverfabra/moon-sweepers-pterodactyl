#!/usr/bin/env bash
set -euo pipefail

moon_mode=run
if (($#)); then moon_mode="$1"; fi
moon_game_pid=""
moon_x_pid=""
moon_log_pid=""
moon_game_started=0
moon_stop_requested=0
moon_forced_stop=0

moon_command() {
    python3 - "$1" <<'PY'
import os
from pathlib import Path
import sys
import tempfile

command = sys.argv[1]
if command not in ("save", "stop"):
    raise SystemExit("Unsupported native command")
directory = Path("/data/control")
directory.mkdir(parents=True, exist_ok=True)
descriptor, temporary = tempfile.mkstemp(prefix=".command-", dir=directory)
try:
    with os.fdopen(descriptor, "w", encoding="ascii") as stream:
        stream.write(command + "\n")
        stream.flush()
        os.fsync(stream.fileno())
    os.replace(temporary, directory / "command")
finally:
    Path(temporary).unlink(missing_ok=True)
PY
}

case "$moon_mode" in
    status)
        python3 - <<'PY'
import json
from pathlib import Path
import sys
import time

path = Path("/data/logs/moon-host-state.json")
try:
    state = json.loads(path.read_text())
    age = time.time() - path.stat().st_mtime
    state["heartbeat_age_seconds"] = round(age, 2)
    state["heartbeat_fresh"] = -2 <= age <= 15
except (OSError, ValueError):
    print(json.dumps({"ready": False, "phase": "not-started", "error": "No valid native state report yet"}))
    sys.exit(1)
print(json.dumps(state, indent=2))
PY
        exit 0
        ;;
    save)
        moon_command save
        echo "Save requested. Check status and the native log for completion."
        exit 0
        ;;
    run|probe|install) ;;
    *) echo "Usage: entrypoint [run|probe|install|status|save]" >&2; exit 2 ;;
esac

if [[ "$moon_mode" == run ]]; then
    python3 - <<'PY'
import os
import re

password = os.environ.get("MOON_SERVER_PASSWORD", "")
if not 8 <= len(password) <= 128 or any(not 32 <= ord(character) <= 126 for character in password):
    raise SystemExit("Set MOON_SERVER_PASSWORD to 8-128 printable ASCII characters. Run scripts/server_setup.py or edit .server.env.")
configured_ids = os.environ.get("MOON_ALLOWED_STEAM_IDS", "").strip()
values = [part.strip() for part in configured_ids.split(",")] if configured_ids else []
valid = not values or (1 <= len(values) <= 15 and len(values) == len(set(values)))
for value in values:
    if not re.fullmatch(r"[0-9]{17}", value):
        valid = False
        continue
    number = int(value)
    if number >> 56 != 1 or (number >> 52) & 15 != 1 or not (number & 0xffffffff):
        valid = False
if not valid:
    raise SystemExit("MOON_ALLOWED_STEAM_IDS must be empty or contain 1-15 distinct public individual SteamID64s.")
ports = []
for setting, default in (("MOON_GAME_PORT", "27025"), ("MOON_QUERY_PORT", "27026")):
    value = os.environ.get(setting, default)
    if not value.isascii() or not value.isdecimal() or not 1024 <= int(value) <= 65535:
        raise SystemExit(setting + " must be a port number from 1024 to 65535.")
    ports.append(int(value))
if ports[0] == ports[1]:
    raise SystemExit("MOON_GAME_PORT and MOON_QUERY_PORT must be different.")
keep = os.environ.get("MOON_BACKUP_KEEP", "10")
if not keep.isdecimal() or not 1 <= int(keep) <= 100:
    raise SystemExit("MOON_BACKUP_KEEP must be an integer from 1 to 100.")
PY
fi

moon_game_running() {
    [[ -n "$moon_game_pid" ]] && kill -0 "$moon_game_pid" 2>/dev/null
}

moon_stop_game() {
    if ! moon_game_running || [[ "$moon_stop_requested" == 1 ]]; then return; fi
    moon_stop_requested=1
    if [[ "$moon_mode" == run ]]; then
        echo "Requesting native save and stop; waiting up to 110 seconds."
        moon_command stop || echo "Could not write the native stop command." >&2
        for ((moon_wait_step=0; moon_wait_step<440; moon_wait_step++)); do
            if ! moon_game_running; then break; fi
            sleep 0.25
        done
    else
        kill -TERM "$moon_game_pid" 2>/dev/null || true
        for ((moon_wait_step=0; moon_wait_step<12; moon_wait_step++)); do
            if ! moon_game_running; then break; fi
            sleep 0.25
        done
    fi
    if moon_game_running; then
        moon_forced_stop=1
        echo "Game did not exit before the stop deadline; forcing termination. No confirmed final-save backup will be created." >&2
        kill -TERM "$moon_game_pid" 2>/dev/null || true
        for ((moon_wait_step=0; moon_wait_step<12; moon_wait_step++)); do
            if ! moon_game_running; then break; fi
            sleep 0.25
        done
        if moon_game_running; then kill -KILL "$moon_game_pid" 2>/dev/null || true; fi
    fi
    wait "$moon_game_pid" 2>/dev/null || true
}

moon_backup_saved_world() {
    [[ "$moon_game_started" == 1 && "$moon_forced_stop" == 0 ]] || return 0
    python3 - <<'PY'
from datetime import datetime, timezone
import io
import json
import os
from pathlib import Path
import tarfile
import tempfile
import uuid

state_path = Path("/data/logs/moon-host-state.json")
try:
    state = json.loads(state_path.read_text())
except (OSError, ValueError):
    raise SystemExit(0)
if state.get("phase") != "stopped" or state.get("save_pending") is not False or state.get("save_failed") is not False:
    print("Skipping automatic backup: native final-save completion was not confirmed.")
    raise SystemExit(0)
prefix = Path(os.environ.get("WINEPREFIX", "/data/wineprefix")).resolve()
sources = [path for path in (prefix / "drive_c/users").glob("*/AppData/LocalLow/DragDropGames/MoonSweepers")
           if path.is_dir() and path.resolve().is_relative_to(prefix)]
if not sources:
    print("No Moon Sweepers save directory found; no automatic backup was created.")
    raise SystemExit(0)
destination = Path("/data/backups")
destination.mkdir(parents=True, exist_ok=True)
now = datetime.now(timezone.utc)
name = f"moon-sweepers-slot{os.environ.get('MOON_SLOT', '1')}-{now:%Y%m%dT%H%M%SZ}-{uuid.uuid4().hex[:8]}.tar.gz"
descriptor, temporary = tempfile.mkstemp(prefix=".backup-", suffix=".tmp", dir=destination)
os.close(descriptor)
try:
    with tarfile.open(temporary, "w:gz", compresslevel=1, dereference=False) as archive:
        for source in sources:
            relative = source.relative_to(prefix / "drive_c/users")
            archive.add(source, arcname=str(Path("saves") / relative),
                        filter=lambda info: info if info.isfile() or info.isdir() else None)
        metadata = json.dumps({"created_at": now.isoformat(), "state": state}, indent=2).encode()
        info = tarfile.TarInfo("backup-metadata.json")
        info.size = len(metadata)
        info.mtime = int(now.timestamp())
        archive.addfile(info, io.BytesIO(metadata))
    os.replace(temporary, destination / name)
finally:
    Path(temporary).unlink(missing_ok=True)
keep = int(os.environ.get("MOON_BACKUP_KEEP", "10"))
archives = sorted((path for path in destination.glob("moon-sweepers-*.tar.gz")
                   if path.is_file() and not path.is_symlink()), key=lambda path: path.stat().st_mtime, reverse=True)
for path in archives[keep:]:
    path.unlink()
print(f"Saved confirmed final-save backup: /data/backups/{name}")
PY
}

moon_cleanup() {
    trap '' TERM INT
    if moon_game_running; then moon_stop_game || true; fi
    wineserver -k 2>/dev/null || true
    if [[ "$moon_mode" == run ]]; then
        moon_backup_saved_world || echo "Automatic backup failed; existing save files and older backups were retained." >&2
    fi
    if [[ -n "$moon_log_pid" ]]; then
        sleep 0.2
        kill -TERM "$moon_log_pid" 2>/dev/null || true
        wait "$moon_log_pid" 2>/dev/null || true
    fi
    if [[ -n "$moon_x_pid" ]]; then kill -TERM "$moon_x_pid" 2>/dev/null || true; fi
}

moon_signal_stop() {
    trap '' TERM INT
    moon_stop_game
    if [[ "$moon_forced_stop" == 1 ]]; then exit 124; fi
    exit 0
}

trap moon_cleanup EXIT
trap moon_signal_stop TERM INT
mkdir -p /data/logs /data/probe /data/control /data/backups
if [[ "$moon_mode" == run ]]; then
    python3 - <<'PY'
from pathlib import Path
import os

Path("/data/control/command").unlink(missing_ok=True)
state = Path("/data/logs/moon-host-state.json")
if state.is_file():
    os.replace(state, state.with_name("moon-host-state.previous.json"))
PY
fi
/opt/moon/bin/server-import
/opt/moon/bin/steam-redist

python3 - <<'PY'
import hashlib
import json
import os
from pathlib import Path
import shutil

root = Path("/data/steam-redist")
info = json.loads((root / ".verified.json").read_text())
for name, record in info["files"].items():
    file = root / record["path"]
    if hashlib.sha256(file.read_bytes()).hexdigest() != record["sha256"]:
        raise SystemExit("Steam server redistributable changed after verification: " + name)
    shutil.copy2(file, Path("/data/game") / name)
app_id = os.environ.get("SteamAppId") or os.environ.get("SteamGameId") or "5335510"
Path("/data/game/steam_appid.txt").write_text(app_id + "\n", encoding="ascii")
PY
if [[ "$moon_mode" == install ]]; then exit 0; fi

Xvfb "$DISPLAY" -screen 0 640x480x24 -nolisten tcp >/data/logs/xvfb.log 2>&1 &
moon_x_pid=$!
for moon_display_attempt in $(seq 1 100); do
    if xdpyinfo -display "$DISPLAY" >/dev/null 2>&1; then break; fi
    if ! kill -0 "$moon_x_pid" 2>/dev/null; then echo "Virtual display failed; see xvfb.log." >&2; exit 1; fi
    sleep 0.1
done
if [[ ! -f "$WINEPREFIX/system.reg" ]]; then
    timeout 90 /usr/lib/wine/wine64 wineboot.exe -u > /data/logs/wineboot.log 2>&1
fi

if [[ "$moon_mode" == probe ]]; then
    cd /data/probe
    export MOON_HOST=0 MOON_DEDICATED=0
    /usr/lib/wine/wine64 /opt/moon/bin/steam-probe.exe \
        'Z:\data\game\MoonSweepers_Data\Plugins\x86_64\steam_api64.dll' \
        'Z:\data\game' &
else
    [[ -f /opt/moon/mod/version.dll ]] || { echo "Native server module is not built in this image." >&2; exit 1; }
    [[ "$MOON_SLOT" =~ ^[1-5]$ ]] || { echo "MOON_SLOT must be 1-5." >&2; exit 1; }
    cp /opt/moon/mod/version.dll /data/game/version.dll
    export MOON_HOST_LOG='Z:\data\logs\moon-host.log'
    export MOON_HOST_STATE='Z:\data\logs\moon-host-state.json'
    export MOON_HOST_COMMAND='Z:\data\control\command'
    touch /data/logs/moon-host.log
    tail -n 0 -F --sleep-interval=0.2 /data/logs/moon-host.log &
    moon_log_pid=$!
    # Unity's player log repeats every managed exception and grows without bound;
    # the host log above is the operator-facing one. MOON_UNITY_LOG opts back in.
    unity_log='Z:\dev\null'
    if [[ -n "${MOON_UNITY_LOG:-}" ]]; then unity_log="$MOON_UNITY_LOG"; else rm -f /data/logs/unity-player.log; fi
    cd /data/game
    /usr/lib/wine/wine64 MoonSweepers.exe \
        -moon-host -moon-headless -moon-slot "$MOON_SLOT" -batchmode -nographics \
        -logFile "$unity_log" &
    moon_game_started=1
fi
moon_game_pid=$!
wait "$moon_game_pid"
