# syntax=docker/dockerfile:1.7
# Pterodactyl/Calagopus runtime for the Moon Sweepers dedicated server.
# Build from the repository root: docker build -f Dockerfile.pterodactyl .

FROM ubuntu:24.04 AS build
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl tar gcc-mingw-w64-x86-64 binutils-mingw-w64-x86-64 \
    && rm -rf /var/lib/apt/lists/*
COPY container/server/steam-probe.c /src/steam-probe.c
RUN mkdir -p /out \
    && x86_64-w64-mingw32-gcc -O2 -Wall -Wextra -Werror \
       -Wno-cast-function-type -static-libgcc \
       /src/steam-probe.c -o /out/steam-probe.exe
ARG MINHOOK_COMMIT=c3fcafdc10146beb5919319d0683e44e3c30d537
RUN mkdir -p /native \
    && curl --fail --location --retry 3 \
       "https://github.com/TsudaKageyu/minhook/archive/${MINHOOK_COMMIT}.tar.gz" \
       | tar -xz --strip-components=1 -C /native
COPY native/*.c native/*.h native/*.S native/*.def /native/host/
RUN cd /native \
    && x86_64-w64-mingw32-gcc -shared -O2 -Wall -Wextra -Werror \
       -Iinclude -Isrc -Ihost host/*.c host/version_proxy.S host/version.def \
       src/buffer.c src/hook.c src/trampoline.c src/hde/hde64.c \
       -static-libgcc -lshell32 -luser32 -lgdi32 \
       -Wl,--no-insert-timestamp -o /out/version.dll \
    && cp LICENSE.txt /out/MinHook-LICENSE.txt

# BepInEx 6 with the Unity 6000.6 fixes (modding/README.md). The interop assemblies need the imported
# GameAssembly.dll, so only the game-independent parts are built here; container/server/bepinex-setup
# generates the rest on the first start with MOON_BEPINEX=1.
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS bepinex
RUN apt-get update && apt-get install -y --no-install-recommends unzip git \
    && rm -rf /var/lib/apt/lists/*
COPY modding /modding
RUN sed -i 's/\r$//' /modding/build-bepinex.sh \
    && bash /modding/build-bepinex.sh prepare /out/bepinex \
    && cp /modding/build-bepinex.sh /out/bepinex/build-bepinex.sh \
    && dotnet publish /modding/modinfo -c Release -v quiet -nologo -o /out/bepinex/modinfo

FROM ubuntu:24.04 AS runtime
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl python3 tini procps tar gzip tzdata libnss-wrapper \
    lib32gcc-s1 lib32stdc++6 lib32z1 wine64 wine xvfb xauth x11-utils \
    dotnet-runtime-8.0 \
    && rm -rf /var/lib/apt/lists/*
# Unity 6000.6 host does not boot under Ubuntu's Wine 9.0 (the 64-bit host
# either access-violates during import resolution or hangs before opening a
# window). Use the current WineHQ stable build, which boots the game and was
# verified end to end, including an anonymous SpaceWar login and a client join.
RUN mkdir -pm755 /etc/apt/keyrings /etc/apt/sources.list.d \
    && curl -fsSL https://dl.winehq.org/wine-builds/winehq.key \
        -o /etc/apt/keyrings/winehq-archive.key \
    && curl -fsSL \
        https://dl.winehq.org/wine-builds/ubuntu/dists/noble/winehq-noble.sources \
        -o /etc/apt/sources.list.d/winehq.sources \
    && dpkg --add-architecture i386 \
    && apt-get update \
    && apt-get install -y --no-install-recommends winehq-stable \
    && rm -rf /var/lib/apt/lists/*
RUN mkdir -p /home/container/game-source /opt/moon/bin /opt/moon/mod \
             /opt/moon/ptero /import \
    && ln -s /home/container/.runtime /data \
    && ln -s /home/container/game-source /import/game
COPY container/server/entrypoint /opt/moon/bin/entrypoint
COPY container/server/steam-redist /opt/moon/bin/steam-redist
COPY container/server/server-import /opt/moon/bin/server-import
COPY container/server/health.py /opt/moon/bin/health.py
COPY container/server/bepinex-setup /opt/moon/bin/bepinex-setup
COPY --from=bepinex /out/bepinex /opt/moon/bepinex
COPY container/server/redist-lock.json /opt/moon/bin/redist-lock.json
COPY --from=build /out/steam-probe.exe /opt/moon/bin/steam-probe.exe
COPY --from=build /out/version.dll /opt/moon/mod/version.dll
COPY --from=build /out/MinHook-LICENSE.txt /opt/moon/mod/MinHook-LICENSE.txt
COPY ptero/supervisor.py /opt/moon/ptero/supervisor.py
COPY ptero/mods.py /opt/moon/ptero/mods.py
COPY ptero/modpm.py /opt/moon/ptero/modpm.py
COPY ptero/game_download.py /opt/moon/ptero/game_download.py
COPY ptero/layout.sh /opt/moon/ptero/layout.sh
COPY ptero/sync-game.py /opt/moon/ptero/sync-game.py
COPY ptero/install.sh /opt/moon/ptero/install.sh
COPY ptero/entrypoint.sh /entrypoint.sh
RUN sed -i 's/\r$//' /entrypoint.sh /opt/moon/ptero/install.sh \
              /opt/moon/ptero/supervisor.py /opt/moon/ptero/mods.py /opt/moon/ptero/modpm.py /opt/moon/ptero/sync-game.py \
              /opt/moon/ptero/game_download.py /opt/moon/ptero/layout.sh \
              /opt/moon/bin/entrypoint /opt/moon/bin/steam-redist \
              /opt/moon/bin/server-import /opt/moon/bin/bepinex-setup \
    && chmod 755 /opt/moon/bin/entrypoint /opt/moon/bin/steam-redist \
              /opt/moon/bin/server-import /opt/moon/bin/bepinex-setup \
              /opt/moon/ptero/install.sh /opt/moon/ptero/layout.sh \
              /entrypoint.sh \
    && chmod 644 /opt/moon/ptero/supervisor.py /opt/moon/ptero/mods.py /opt/moon/ptero/modpm.py /opt/moon/ptero/sync-game.py \
              /opt/moon/ptero/game_download.py
# No USER directive: Wings starts the server as its own uid:gid, and the
# install container must stay root to write into /mnt/server.
ENV HOME=/home/container/.runtime/home \
    USER=container \
    WINEARCH=win64 \
    WINEPREFIX=/data/wineprefix \
    WINEDEBUG=-all \
    DISPLAY=:99 \
    SteamAppId=5335510 \
    SteamGameId=5335510 \
    MOON_HOST=1 \
    MOON_DEDICATED=1 \
    MOON_HEADLESS=1 \
    MOON_SLOT=1 \
    MOON_GAME_PORT=27025 \
    MOON_QUERY_PORT=27026 \
    MOON_BACKUP_KEEP=10 \
    MOON_BEPINEX=0 \
    DOTNET_CLI_TELEMETRY_OPTOUT=1 \
    WINEDLLOVERRIDES="mscoree,mshtml=;version=n,b;winmm=b;winealsa.drv=d"
WORKDIR /home/container
# Wings does not pass a command: it relies on the image's ENTRYPOINT/CMD to run
# the egg's STARTUP. tini (without -g) reaps Wine's child processes and forwards
# signals only to the supervisor, which handles the graceful save/stop itself.
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["/entrypoint.sh"]
LABEL org.opencontainers.image.title="Moon Sweepers Pterodactyl runtime" \
      org.opencontainers.image.description="Unofficial Moon Sweepers CPU-only server runtime for Pterodactyl"
