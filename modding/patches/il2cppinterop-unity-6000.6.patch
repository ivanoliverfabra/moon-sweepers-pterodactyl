+// Unity 6000.6+: one entry of the merged interface table (see NativeClassStructHandler_6000_6). The first two
+// fields line up with Il2CppRuntimeInterfaceOffsetPair, which is 16 bytes with padding where depth now lives.
+public unsafe struct Il2CppInterfaceTableEntry
+{
+    public Il2CppClass* interfaceType;
+    public int offset;  // vtable offset, or -1 for entries without one
+    public int depth;   // 0 = implemented directly, n = inherited n levels away, int.MaxValue = offset-only
+}
+
 [StructLayout(LayoutKind.Sequential)]
 public struct Il2CppObject
 {
